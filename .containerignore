# Mirrors .gitignore, plus explicit exclusions for data that must never
# enter a build layer even though it's already gitignored/untracked — see
# the "PII" section of src/jobomatic/interfaces/mcp/README.md for why.

outputs/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
.venv-1/
.venv-2/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.git/
plans/

# PII lives in the separate private vault repo, which is outside this build context and reaches
# the running container only through the bind mount documented in src/jobomatic/interfaces/mcp/README.md. These
# patterns are a safety net in case a personal file is ever copied into the code repo.
private/
**/applications.jsonl
**/pluralsight_learning_history.json
