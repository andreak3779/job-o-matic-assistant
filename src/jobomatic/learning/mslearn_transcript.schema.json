{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microsoft Learn transcript (share-link JSON), the parts this tool reads",
  "type": "object",
  "required": ["modulesCompleted", "learningPathsCompleted"],
  "properties": {
    "totalModulesCompleted": {"type": "integer", "minimum": 0},
    "totalLearningPathsCompleted": {"type": "integer", "minimum": 0},
    "totalTrainingMinutes": {"type": "integer", "minimum": 0},
    "modulesCompleted": {"type": "array", "items": {"$ref": "#/$defs/completedItem"}},
    "learningPathsCompleted": {"type": "array", "items": {"$ref": "#/$defs/completedItem"}},
    "certificationData": {
      "type": "object",
      "properties": {
        "activeCertifications": {"type": "array", "items": {"$ref": "#/$defs/certification"}},
        "historicalCertifications": {"type": "array", "items": {"$ref": "#/$defs/certification"}},
        "passedExams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["examTitle", "examNumber"],
            "properties": {
              "examTitle": {"type": "string"},
              "examNumber": {"type": "string"},
              "examDateTaken": {"type": "string"}
            }
          }
        }
      }
    },
    "appliedSkillsData": {
      "type": "object",
      "properties": {
        "appliedSkillsCredentials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": {"title": {"type": "string"}, "awardedOn": {"type": "string"}}
          }
        }
      }
    }
  },
  "$defs": {
    "completedItem": {
      "type": "object",
      "required": ["uid", "title", "durationInMinutes", "completedOn"],
      "properties": {
        "uid": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "durationInMinutes": {"type": "integer", "minimum": 0},
        "completedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
        "url": {"type": "string"}
      }
    },
    "certification": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}, "dateEarned": {"type": "string"}}
    }
  }
}
